{
  "name": "notes",
  "version": "0.4.0",
  "description": "Web app Notes that give the ability to note draggable notes to topics on boards",
  "main": "index.js",
  "scripts": {
    "dev": "webpack serve --config webpack.dev.js",
    "dev:rspack": "rspack serve --config rspack.dev.js",
    "flow:check": "flow check",
    "test": "jest",
    "test:watch": "jest --watch",
    "transpile": "babel ./src --out-dir ./js --source-maps --ignore test.js",
    "transpile:all": "babel ./src --out-dir ./js --source-maps",
    "lint:one": "eslint -c eslint.config.js",
    "lint:biome": "npx @biomejs/biome lint ./src --colors=off",
    "css:min": "node css-min.js",
    "css:sass": "node css-sass.js",
    "css:all": "npm run css:sass && npm run css:min",
    "build:prod": "webpack --color --progress --config webpack.prod.js"
  },
  "author": "Yevhenii Molodyi",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@reduxjs/toolkit": "^2.12.0",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-flow": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@biomejs/biome": "^2.5.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@rspack/cli": "^2.0.8",
    "@rspack/core": "^2.0.8",
    "@rspack/dev-server": "^2.1.0",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@swc/helpers": "^0.5.23",
    "babel-loader": "^10.1.1",
    "clean-css": "^5.3.3",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.4.2",
    "react-refresh": "^0.18.0",
    "sass": "^1.101.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "glob": "~13.0.6",
    "uuid": "~14.0.0",
    "js-yaml": "~4.2.0"
  },
  "jest": {
    "roots": [
      "<rootDir>/js/utils/",
      "<rootDir>/js/flux/",
      "<rootDir>/js/component/"
    ],
    "transformIgnorePatterns": [
      "<rootDir>/js/utils/",
      "<rootDir>/js/flux/",
      "<rootDir>/js/component/"
    ]
  }
}
